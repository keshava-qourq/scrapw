# --- App ---
APP_NAME=product-search-engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_search
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/product_search

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Search (OpenSearch) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_PRODUCT_INDEX=products

# --- Marketplace: Amazon (Product Advertising API / affiliate feed) ---
# Requires an approved Amazon Associates account + PA-API credentials.
# https://webservices.amazon.com/paapi5/documentation/
AMAZON_API_ENABLED=false
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_REGION=us-east-1
AMAZON_REQUESTS_PER_SECOND=1
AMAZON_MAX_CONCURRENT_REQUESTS=2
AMAZON_TIMEOUT_SECONDS=10
AMAZON_RETRY_COUNT=3

# --- Marketplace: Flipkart (Affiliate API) ---
# Requires approval via https://affiliate.flipkart.com/
FLIPKART_API_ENABLED=false
FLIPKART_API_KEY=
FLIPKART_API_SECRET=
FLIPKART_REQUESTS_PER_SECOND=1
FLIPKART_MAX_CONCURRENT_REQUESTS=2
FLIPKART_TIMEOUT_SECONDS=10
FLIPKART_RETRY_COUNT=3

# --- Marketplace: AJIO ---
# No known public/affiliate product-data API at this time.
# Connector runs in mock mode until a permitted access mechanism is configured.
AJIO_API_ENABLED=false
AJIO_API_KEY=
AJIO_API_SECRET=
AJIO_REQUESTS_PER_SECOND=1
AJIO_MAX_CONCURRENT_REQUESTS=2
AJIO_TIMEOUT_SECONDS=10
AJIO_RETRY_COUNT=3

# --- Marketplace: Myntra ---
# No known public/affiliate product-data API at this time.
# Connector runs in mock mode until a permitted access mechanism is configured.
MYNTRA_API_ENABLED=false
MYNTRA_API_KEY=
MYNTRA_API_SECRET=
MYNTRA_REQUESTS_PER_SECOND=1
MYNTRA_MAX_CONCURRENT_REQUESTS=2
MYNTRA_TIMEOUT_SECONDS=10
MYNTRA_RETRY_COUNT=3

# --- Query understanding (Gemini) ---
# Optional: powers natural-language search (/api/v1/products/search/smart).
# Get a key at https://aistudio.google.com/apikey. Leave blank to disable —
# the smart endpoint falls back to treating the whole input as a plain query.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=10

# --- Live search (SerpApi provider) ---
# Optional: powers GET /api/v1/search/live with real cross-marketplace results.
# Free tier at https://serpapi.com. Leave blank to disable the endpoint.
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_shopping
SERPAPI_TIMEOUT_SECONDS=15
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_RATE_LIMIT=30/minute
MAX_CONCURRENT_PROVIDERS=4
